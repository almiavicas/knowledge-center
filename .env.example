HOST=127.0.0.1
PORT=8787

# Local agent runtime endpoint. Leave empty to keep the web UI in setup mode.
AGENT_CHAT_URL=
AGENT_CHAT_FORMAT=simple
AGENT_API_KEY=
AGENT_MODEL=gpt-5.4-mini

# Provider credentials used by the local agent runtime and GBrain embeddings.
# Keep this file private if you copy it to .env.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
GBRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
GBRAIN_EMBEDDING_DIMENSIONS=1536

# Passed through to the agent proxy so the runtime can know where GBrain lives.
GBRAIN_MCP_MODE=stdio
GBRAIN_MCP_COMMAND="gbrain serve"
GBRAIN_HTTP_URL=http://127.0.0.1:3131/mcp
