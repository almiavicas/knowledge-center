HOST=127.0.0.1
PORT=8787

AGENT_CHAT_URL=http://127.0.0.1:3020/chat
AGENT_CHAT_FORMAT=simple
AGENT_API_KEY=
AGENT_MODEL=gpt-5.4-mini

# OpenAI is the cost-optimized MVP provider for both chat and GBrain embeddings.
# Set OPENAI_API_KEY before GBrain initialization.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
GBRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
GBRAIN_EMBEDDING_DIMENSIONS=1536

# Set this to the command that starts OpenClaw or another compatible local runtime.
# The process should expose AGENT_CHAT_URL above.
AGENT_RUNTIME_CMD=

GBRAIN_MCP_MODE=stdio
GBRAIN_MCP_COMMAND="gbrain serve"
GBRAIN_HTTP_BIND=127.0.0.1
GBRAIN_HTTP_PORT=3131
GBRAIN_HTTP_URL=http://127.0.0.1:3131/mcp
